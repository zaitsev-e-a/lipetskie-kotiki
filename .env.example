# Липецкие котики — ИИ, который не обманывает. Настройки.
# Скопируйте файл в .env и впишите ключ OpenRouter. Файл .env не публикуйте и не пересылайте.

# ===================================================================== OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Модель по умолчанию: используется компонентом, если ниже для него не указана своя
OPENROUTER_MODEL=qwen/qwen3.8-flash
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# Запасная модель для всех компонентов: если основная после повторов не ответила или нарушила формат,
# тот же запрос уходит сюда. Пусто — без замены. Для отдельного компонента: FALLBACK_MODEL_<КОМПОНЕНТ>=...
OPENROUTER_FALLBACK_MODEL=
# Провайдер OpenRouter (необязательно), например Alibaba. Для отдельного компонента: PROVIDER_<КОМПОНЕНТ>=...
OPENROUTER_PROVIDER=
# 0 — узнать окно контекста модели у OpenRouter; иначе лимит в токенах
MODEL_CONTEXT_TOKENS=0
# 1 — режим размышлений medium для всех компонентов (медленнее и дороже)
OPENROUTER_REASONING=0
LLM_TIMEOUT_SECONDS=120
TRANSPORT_RETRIES=3
LLM_CACHE=1
# Лимит ответа модели для ролей, у которых он не задан ниже
MAX_OUTPUT_TOKENS=1500

# ===================================================================== Модели компонентов
# Паспорт закупки (подготовка, один раз на снимок)
MODEL_EXTRACT=qwen/qwen3.8-flash
MODEL_PASSPORT_REPAIR=qwen/qwen3.8-flash
MODEL_PASSPORT_GAP=qwen/qwen3.8-flash
MODEL_AMEND=qwen/qwen3.8-flash
MODEL_CONFLICT=qwen/qwen3.8-flash
# Защита от инъекций: классификатор спорных фрагментов
MODEL_GUARD=qwen/qwen3.8-flash
# Ответ на вопрос
MODEL_CONTEXTUALIZER=qwen/qwen3.8-flash
MODEL_READER=qwen/qwen3.8-flash
MODEL_MERGE=qwen/qwen3.8-flash
MODEL_JUDGE=qwen/qwen3.8-flash
# Проверки: общий критик и проверка отсутствия сведений
MODEL_VALIDATOR=qwen/qwen3.8-flash
MODEL_ABSENCE=qwen/qwen3.8-flash
# Панель критиков: общая модель и модель каждого критика
MODEL_CRITIC=qwen/qwen3.8-flash
MODEL_CRITIC_ATTRIBUTE=qwen/qwen3.8-flash
MODEL_CRITIC_UNITS=qwen/qwen3.8-flash
MODEL_CRITIC_AMENDMENT=qwen/qwen3.8-flash
MODEL_CRITIC_DISCREPANCY=qwen/qwen3.8-flash
MODEL_CRITIC_CALCULATION=qwen/qwen3.8-flash
MODEL_CRITIC_POLARITY=qwen/qwen3.8-flash
# Режим «было» — один запрос к модели, для сравнения
MODEL_BASELINE=qwen/qwen3.8-flash

# ===================================================================== Лимиты ответа и размышления компонентов
# REASONING_*: off | low | medium | high
MAX_TOKENS_EXTRACT=6000
MAX_TOKENS_PASSPORT_REPAIR=3000
MAX_TOKENS_PASSPORT_GAP=2500
MAX_TOKENS_AMEND=1500
MAX_TOKENS_CONFLICT=2000
MAX_TOKENS_GUARD=1200
MAX_TOKENS_CONTEXTUALIZER=300
MAX_TOKENS_READER=3500
MAX_TOKENS_MERGE=1500
MAX_TOKENS_JUDGE=1500
MAX_TOKENS_VALIDATOR=6000
MAX_TOKENS_ABSENCE=4000
MAX_TOKENS_CRITIC=2500
MAX_TOKENS_BASELINE=1500
REASONING_EXTRACT=off
REASONING_PASSPORT_REPAIR=off
REASONING_PASSPORT_GAP=off
REASONING_AMEND=off
REASONING_CONFLICT=low
REASONING_GUARD=off
REASONING_CONTEXTUALIZER=off
REASONING_READER=off
REASONING_MERGE=off
REASONING_JUDGE=low
REASONING_VALIDATOR=low
REASONING_ABSENCE=low
REASONING_CRITIC=off
REASONING_BASELINE=off

# ===================================================================== Чтение документов
# auto | full_context | retrieval | exhaustive
READ_MODE=auto
# auto читает комплект целиком, только если он не больше этого размера (токены); большие — через поиск
FULL_CONTEXT_MAX_TOKENS=120000
CONTEXT_BUDGET_RATIO=0.8
USE_PASSPORT=1
STRICT_COVERAGE=1
WINDOW_TOKENS=6000
# Сплошной обход большого комплекта: соседние окна читаются порциями до этого размера (токены)
SWEEP_TOKENS=60000
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
BLOCK_MAX_CHARS=1500

# ===================================================================== Паспорт, критики, защита, самовосстановление
# Повтор отклонённых фактов паспорта и прицельный добор атрибутов чек-листа
PASSPORT_REPAIR=1
PASSPORT_CHECKLIST=1
# Общий критик (валидатор) и панель критиков: all | none | список через запятую
# (attribute,units,amendment,discrepancy,calculation,polarity). Проверки кодом работают всегда.
USE_CRITIC=1
CRITICS=all
# Защита от инъекций: детектор и карантин работают всегда; 1 — ещё и классификатор моделью
GUARD_LLM=1
# Повтор вопроса при технической ошибке; вторая попытка «не знаю» другим способом чтения
QUESTION_RETRIES=1
ESCALATE_UNKNOWN=1

# ===================================================================== Поиск (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Qdrant недоступен: 1 — тот же гибридный поиск в памяти процесса, 0 — чтение всех окон подряд
LOCAL_INDEX=1
RETRIEVAL_TOP_K=12
PREFETCH_LIMIT=40
RRF_K=60

# ===================================================================== Параллельность и бюджеты
QUESTION_CONCURRENCY=6
GLOBAL_LLM_CONCURRENCY=16
MAX_LLM_CALLS_PER_QUESTION=40
QUESTION_DEADLINE_SECONDS=300
REPAIR_ROUNDS=2

# ===================================================================== Сайт
HOST=127.0.0.1
PORT=8000
# Пусто — папка data рядом с программой
DATA_DIR=

# ===================================================================== Голосовой ввод и OCR
# Модель распознавания речи GigaAM (локально, на CPU)
ASR_MODEL=v3_e2e_rnnt
# OCR сканов в PDF (необязательно): путь к tesseract.exe, если его нет в PATH, и языки
TESSERACT_CMD=
OCR_LANG=rus+eng
